rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Profil Alumni: Publik dapat membaca (untuk showcase talenta & direktori),
    // hanya pemilik akun terautentikasi yang dapat menulis profil miliknya.
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Lowongan Kerja: Publik dapat melihat lowongan yang tersedia.
    // Pembuatan lowongan wajib mencantumkan identitas akun pembuat (postedBy / posterUid).
    // Hanya pembuat lowongan yang berhak memperbarui atau menghapus lowongannya.
    match /jobs/{jobId} {
      allow read: if true;
      allow create: if request.auth != null && (
        request.resource.data.postedBy == request.auth.uid || 
        request.resource.data.posterUid == request.auth.uid
      );
      allow update, delete: if request.auth != null && (
        resource.data.postedBy == request.auth.uid || 
        resource.data.posterUid == request.auth.uid
      );
    }

    // Lamaran Kerja: Bersifat privat antara pelamar dan pemilik lowongan.
    // Mencegah Privilege Escalation: Hanya pemilik lowongan (posterUid) yang berhak mengubah status lamaran.
    // Pelamar tidak dapat mengubah status menjadi 'accepted' sendiri.
    match /applications/{applicationId} {
      allow read: if request.auth != null && (
        resource.data.applicantUid == request.auth.uid || 
        resource.data.posterUid == request.auth.uid
      );
      // Pelamar hanya dapat membuat lamaran baru dengan status awal 'pending'
      allow create: if request.auth != null 
                    && request.resource.data.applicantUid == request.auth.uid
                    && request.resource.data.status == 'pending';
      // HANYA poster/pemilik lowongan yang berhak mengubah status, field ID tidak boleh diganti
      allow update: if request.auth != null 
                    && resource.data.posterUid == request.auth.uid
                    && request.resource.data.applicantUid == resource.data.applicantUid
                    && request.resource.data.jobId == resource.data.jobId;
      // Pelamar hanya dapat menarik/menghapus lamarannya sendiri
      allow delete: if request.auth != null && resource.data.applicantUid == request.auth.uid;
    }

    // Permintaan Akses Kontak Alumni (Privasi WhatsApp & Nomor Telepon)
    // Hanya pemohon dan target yang berhak membaca request.
    // Pemohon hanya dapat membuat request berstatus 'pending'.
    // Hanya target (pemilik profil) yang berhak mengubah status (menyetujui atau menolak).
    match /contact_requests/{requestId} {
      allow read: if request.auth != null && (
        resource.data.requesterUid == request.auth.uid || 
        resource.data.targetUid == request.auth.uid
      );
      allow create: if request.auth != null 
                    && request.resource.data.requesterUid == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow update: if request.auth != null 
                    && resource.data.targetUid == request.auth.uid
                    && request.resource.data.requesterUid == resource.data.requesterUid
                    && request.resource.data.targetUid == resource.data.targetUid;
      allow delete: if request.auth != null && resource.data.requesterUid == request.auth.uid;
    }

    // Basis Data Master Alumni STMM MMTC (Registry Whitelist)
    // Pendaftar publik dapat membaca untuk mencocokkan nomor alumni dan nama lengkap saat registrasi.
    // Akun terautentikasi dapat mengelola data dan memperbarui status klaim pendaftaran.
    match /alumni_registry/{alumniId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Tolak semua akses ke koleksi lain secara default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
