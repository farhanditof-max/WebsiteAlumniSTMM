rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Profil Alumni: Publik dapat membaca (untuk showcase talenta & halaman profil),
    // hanya pemilik akun terautentikasi yang dapat menulis profil miliknya.
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Lowongan Kerja: Publik dapat melihat lowongan yang tersedia.
    // Pembuatan lowongan wajib mencantumkan identitas akun pembuat (postedBy / posterUid).
    // Hanya pembuat lowongan yang berhak memperbarui atau menghapus lowongannya.
    match /jobs/{jobId} {
      allow read: if true;
      allow create: if request.auth != null && (
        request.resource.data.postedBy == request.auth.uid || 
        request.resource.data.posterUid == request.auth.uid
      );
      allow update, delete: if request.auth != null && (
        resource.data.postedBy == request.auth.uid || 
        resource.data.posterUid == request.auth.uid
      );
    }

    // Lamaran Kerja: Bersifat privat antara pelamar dan pemilik lowongan.
    // Hanya pelamar (applicantUid) atau pemilik lowongan (posterUid) yang dapat mengakses.
    match /applications/{applicationId} {
      allow read: if request.auth != null && (resource.data.applicantUid == request.auth.uid || resource.data.posterUid == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.applicantUid == request.auth.uid;
      allow update: if request.auth != null && (resource.data.posterUid == request.auth.uid || resource.data.applicantUid == request.auth.uid);
      allow delete: if request.auth != null && (resource.data.applicantUid == request.auth.uid || resource.data.posterUid == request.auth.uid);
    }

    // Tolak semua akses ke koleksi lain secara default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
