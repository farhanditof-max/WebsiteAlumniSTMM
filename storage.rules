rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Foto profil alumni: Publik dapat membaca, tetapi HANYA pemilik akun (UID) yang dapat mengunggah/menghapus
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Dokumen CV: HANYA dapat dibaca, diunggah, dan dihapus oleh pemilik akun (UID) terkait
    // Mencegah mass PII download (BOLA) dan arbitrary overwrite/deletion
    match /cv_documents/{userId}/{fileName} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024
                   && (
                     request.resource.contentType.matches('application/pdf') ||
                     request.resource.contentType.matches('application/msword') ||
                     request.resource.contentType.matches('application/vnd.openxmlformats-officedocument.wordprocessingml.document') ||
                     request.resource.contentType.matches('image/.*')
                   );
    }

    // Fallback path datar lama (mencegah penulisan file tak terisolasi)
    match /avatars/{fileName} {
      allow read: if true;
      allow write: if false;
    }
    match /cv_documents/{fileName} {
      allow read, write: if false;
    }

    // Tolak semua path lainnya secara default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
