rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Foto profil alumni:
    // F-23 Fix: Pisahkan delete dari create/update agar request.resource null tidak membatalkan delete
    // Batasi tipe file hanya jpeg/png/webp (tolak SVG aktif untuk cegah Stored XSS)
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    // Dokumen CV:
    // HANYA dapat dibaca, diunggah, dan dihapus oleh pemilik akun (UID) terkait
    // Mencegah mass PII download (BOLA) dan arbitrary overwrite/deletion
    match /cv_documents/{userId}/{fileName} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('application/pdf');
    }

    // Fallback path datar lama (mencegah penulisan file tak terisolasi)
    match /avatars/{fileName} {
      allow read: if true;
      allow write: if false;
    }
    match /cv_documents/{fileName} {
      allow read, write: if false;
    }

    // Tolak semua path lainnya secara default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
